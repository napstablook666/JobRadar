+                launcherExitedLogged = true;
+            }
+            if (isCdpReachable(port)) {
+                return true;
+            }
+            try {
+                Thread.sleep(300);
+            } catch (InterruptedException ie) {
+                Thread.currentThread().interrupt();
+                return false;
+            }
+        }
+        return false;
+    }
