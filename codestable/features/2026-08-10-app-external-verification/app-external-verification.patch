+        String wrapped = "(function(){try{if(location&&location.origin===\"https://www.zhipin.com\"){"
+                + "if(window.__bossAntiDetectInjected){return;}window.__bossAntiDetectInjected=true;"
+                + script + "}}catch(e){}})();";
