+    private boolean waitForCdpClosed(int port, long timeoutMs) {
+        long deadline = System.currentTimeMillis() + timeoutMs;
+        while (System.currentTimeMillis() < deadline) {
+            if (!isCdpReachable(port)) {
+                return true;
+            }
+            try {
