+            throw new IllegalStateException("缺少 API Base URL，请先填写或保存 BASE_URL");
+        }
+        if (resolvedApiKey == null || resolvedApiKey.isBlank()) {
+            throw new IllegalStateException("缺少 API Key，请先填写或保存 API_KEY");
+        }
