+    static boolean passesAutoAiScreening(LiepinConfig config, LiepinAiAssessment assessment) {
+        return config != null
+                && config.isAutoAiDeliveryEnabled()
+                && assessment != null
+                && assessment.passes(config.effectiveAiMinScore());
