+            ps.setString(2, city);
+            ps.setString(3, salary);
+            ps.setInt(4, page);
+            ps.setTimestamp(5, Timestamp.valueOf(LocalDateTime.now()));
+            ps.executeUpdate();
+        } catch (Exception e) {
