+    private String extractChromeMajor(String version, String fallback) {
+        if (version == null || version.isBlank()) {
+            return fallback;
+        }
+        Matcher m = Pattern.compile("(\\d+)").matcher(version);
+        if (m.find()) {
+            return m.group(1);
+        }
+        return fallback;
+    }
