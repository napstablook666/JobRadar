+    private void configureContext(BrowserContext targetContext) {
+        if (targetContext == null) {
+            return;
+        }
+        try {
+            targetContext.onPage(this::configurePage);
+            for (Page page : targetContext.pages()) {
+                configurePage(page);
+            }
