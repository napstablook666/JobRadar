+    private void waitBetweenJobs() {
+        if (processedCount <= 1) return;
+        int min = config.effectiveMinDelaySeconds();
+        int max = config.effectiveMaxDelaySeconds();
+        int seconds = ThreadLocalRandom.current().nextInt(min, max + 1);
+        long remainingMillis = seconds * 1000L;
+        while (remainingMillis > 0 && !shouldStop()) {
+            long sleepMillis = Math.min(250L, remainingMillis);
+            try {
+                Thread.sleep(sleepMillis);
+                remainingMillis -= sleepMillis;
+            } catch (InterruptedException e) {
+                Thread.currentThread().interrupt();
+                info("等待岗位间隔时收到停止指令");
+                return;
+            }
+        }
+    }
