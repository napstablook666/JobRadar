+        field.setAccessible(true);
+        if (value instanceof Long longValue) {
+            field.setLong(target, longValue);
+        } else if (value instanceof Boolean booleanValue) {
+            field.setBoolean(target, booleanValue);
+        } else {
+            field.set(target, value);
