--- a/一键启动.bat
+++ /dev/null
@@
-@echo off
-setlocal EnableExtensions
-cd /d "%~dp0"
-set "GETJOBS_NO_PAUSE=1"
-powershell.exe -NoProfile -WindowStyle Hidden -ExecutionPolicy Bypass -File "%~dp0bin\start-services.ps1" %*
-set "ERR=%ERRORLEVEL%"
-endlocal & exit /b %ERR%
--- a/一键停止.bat
+++ /dev/null
@@
-@echo off
-setlocal EnableExtensions
-cd /d "%~dp0"
-powershell.exe -NoProfile -ExecutionPolicy Bypass -File "%~dp0bin\stop-services.ps1" %*
-set "ERR=%ERRORLEVEL%"
-endlocal & exit /b %ERR%
--- /dev/null
+++ b/restart.bat
@@
+@echo off
+setlocal EnableExtensions
+cd /d "%~dp0"
+set "GETJOBS_NO_PAUSE=1"
+
+call "%~dp0stop.bat" -Quiet
+set "ERR=%ERRORLEVEL%"
+if not "%ERR%"=="0" goto :done
+
+call "%~dp0start.bat" %*
+set "ERR=%ERRORLEVEL%"
+
+:done
+endlocal & exit /b %ERR%
--- a/bin/start-services.ps1
+++ b/bin/start-services.ps1
@@
-Write-Host " Stop:    double-click 一键停止.bat  (or stop.bat)"
+Write-Host " Stop:    double-click stop.bat"
+Write-Host " Restart: double-click restart.bat"
