+    private Page findOrCreatePage(List<Page> existing, Set<Page> claimed, String domainHint) {
+        for (Page p : existing) {
+            if (p == null || claimed.contains(p)) {
+                continue;
+            }
+            try {
+                String u = p.url();
+                if (u != null && u.contains(domainHint)) {
+                    claimed.add(p);
+                    return p;
+                }
+            } catch (Exception ignored) {
+            }
+        }
+        Page created = context.newPage();
+        claimed.add(created);
+        return created;
+    }
